{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trica Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true,
        "required": [
          "name"
        ]
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Required: Secret holding the PostgreSQL URL."
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "description": "Server configuration (docs/reference/configuration.md); http.addr, database.url_file, transport.addr/ca_dir/hosts, collect.targets_file, live (from live.config), schema_overlays and devicetypes.extra_dir (with deviceTypes.existingClaim) are set by the chart."
    },
    "schemaOverlays": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "deviceTypes": {
      "type": "object",
      "description": "The operator's device models and face images (devicetypes.extra_dir, docs/reference/devicetypes.md), on a PersistentVolumeClaim mounted read-only at /etc/trica/devicetypes.",
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "subPath": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "description": "The look of the console (docs/reference/themes.md): a built-in theme, or a ConfigMap holding a theme (its files, or a zip under archiveKey), mounted read-only at /etc/trica/theme, or a zip downloaded once from an https url that must match sha256; locked makes this configuration win over the console.",
      "properties": {
        "builtin": {
          "type": "string",
          "enum": ["", "default", "flat"]
        },
        "existingConfigMap": {
          "type": "string"
        },
        "archiveKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]*$"
        },
        "url": {
          "type": "string",
          "pattern": "^(https://.*)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        },
        "locked": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string"
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "existingClaim": {
          "type": "string"
        },
        "subPath": {
          "type": "string"
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "collect": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true,
            "required": [
              "kind",
              "name"
            ]
          }
        },
        "targetsConfigMap": {
          "type": "string"
        },
        "targetsKey": {
          "type": "string",
          "minLength": 1
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "name"
            ]
          }
        },
        "kubernetes": {
          "type": "object",
          "properties": {
            "rbac": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "live": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "description": "The server's live block (docs/reference/configuration.md#live-topology-overlay); credentials are file: or env: references.",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://[^/?#@]+(/[^?#]*)?$"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string",
              "pattern": "^(file|env):.+"
            },
            "bearer_token": {
              "type": "string",
              "pattern": "^(file|env):.+"
            },
            "refresh": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
            },
            "rate_window": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ca_file": {
                  "type": "string"
                },
                "insecure": {
                  "type": "boolean"
                },
                "min_version": {
                  "enum": [
                    "1.0",
                    "1.1",
                    "1.2",
                    "1.3"
                  ]
                }
              }
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "arista",
                      "mikrotik",
                      "pfsense",
                      "node",
                      "generic"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]+$"
                  },
                  "metrics": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "rx": {
                        "type": "string",
                        "pattern": "^([a-zA-Z_:][a-zA-Z0-9_:]*|-)$"
                      },
                      "tx": {
                        "type": "string",
                        "pattern": "^([a-zA-Z_:][a-zA-Z0-9_:]*|-)$"
                      },
                      "oper": {
                        "type": "string",
                        "pattern": "^([a-zA-Z_:][a-zA-Z0-9_:]*|-)$"
                      }
                    }
                  },
                  "labels": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "device": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                        }
                      },
                      "interface": {
                        "type": "string",
                        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                      }
                    }
                  },
                  "matchers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "exclude_interfaces": {
                    "type": "string"
                  },
                  "unit": {
                    "enum": [
                      "bytes",
                      "bits"
                    ]
                  }
                }
              }
            }
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        },
        "claims": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egressTo": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "additionalProperties": false
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "existingClaim": {
          "type": "string"
        },
        "subPath": {
          "type": "string"
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
