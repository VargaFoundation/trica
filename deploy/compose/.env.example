# Copy to .env and change. .env is not committed.
TRICA_DB_PASSWORD=change-me
# Address the server is published on; 127.0.0.1 keeps it local.
TRICA_BIND=127.0.0.1
# Image to run. The default, trica:local, is built from this checkout by
# `docker compose up --build`; set another one to run an image from your
# registry (or a released one you can pull).
TRICA_IMAGE=trica:local
